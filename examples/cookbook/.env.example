# 复制为 examples/cookbook/.env，并替换所有占位值。
# 真实 .env 已被 Git 忽略。

TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-guangzhou
AGS_ROLE_ARN=

# personal 对应腾讯云 CCR；enterprise 对应腾讯云 TCR。
# 为保持示例紧凑，主镜像、Runtime 和 Sidecar 使用同一种类型；SDK 允许每个挂载镜像
# 分别指定类型。
SANDCAMP_IMAGE_REGISTRY_TYPE=personal
SANDCAMP_MAIN_IMAGE=ccr.ccs.tencentyun.com/<namespace>/<main-repository>:<tag>
SANDCAMP_RUNTIME_IMAGE=ccr.ccs.tencentyun.com/<namespace>/sandcamp-runtime:beta
SANDCAMP_SIDECAR_IMAGE=ccr.ccs.tencentyun.com/<namespace>/<sidecar-repository>:<tag>
