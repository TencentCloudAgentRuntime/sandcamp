# 复制为 examples/cookbook/.env，并替换所有占位值。
# 真实 .env 已被 Git 忽略。

TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-guangzhou
AGS_ROLE_ARN=

# personal 表示个人版；enterprise 表示企业版。
# 为保持示例紧凑，主镜像、Runtime 和 Sidecar 使用同一种类型；SDK 允许每个挂载镜像
# 分别指定类型。
SANDCAMP_IMAGE_REGISTRY_TYPE=personal

# 先把下列固定 linux/amd64 上游镜像同步到自己的腾讯云镜像仓库：
#   docker.io/library/bash@sha256:534a5f1d11652aadaa9f08838f6637ac11a46a8b4b736a4cbf09c5945e38516f
#   docker.io/opensandbox/egress@sha256:0dd9727216b535fa34ef77495c3e465da848b888c28ee4be4f92c1003a97a71f
# Runtime 镜像从 ghcr.io/tencentcloudagentruntime/sandcamp-runtime:v0.1.0-beta 同步。
# AGS 主镜像字段 CustomConfiguration.Image 必须带 tag，且不接受
# @sha256:digest。本例为三个镜像统一使用不可变目标 tag，并在同步时
# 校验上游 digest。
SANDCAMP_MAIN_IMAGE=<personal-or-enterprise-registry>/bash:sandcamp-cookbook
SANDCAMP_RUNTIME_IMAGE=<personal-or-enterprise-registry>/sandcamp-runtime:v0.1.0-beta
SANDCAMP_EGRESS_IMAGE=<personal-or-enterprise-registry>/egress:sandcamp-cookbook
